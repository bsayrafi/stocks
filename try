import yfinance as yf, pandas as pd

for t in ["QTWO", "PGY", "CRWV"]:
    df = yf.download(t, period="6mo", auto_adjust=True, progress=False)
    print(t, df.shape, "MultiIndex" if isinstance(df.columns, pd.MultiIndex) else "flat")
    print(df.columns.tolist()[:6])
    print(df[["Close"]].tail(2) if not df.empty else "EMPTY")
    print("-" * 40)