<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MDS daily scan, Mon-Fri 23:40 Israel time (~16:40 New York, after the close).
  Install:
    cp com.bassem.mds-daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.bassem.mds-daily.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bassem.mds-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/bsayrafi/Documents/pworkspace/stocks/run_mds.sh</string>
        <string>daily</string>
        <string>--size</string>
        <string>2</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>40</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/bsayrafi/Documents/pworkspace/stocks/live/mds_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bsayrafi/Documents/pworkspace/stocks/live/mds_launchd.err.log</string>
</dict>
</plist>
